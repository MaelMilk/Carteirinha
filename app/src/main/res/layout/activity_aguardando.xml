<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_light"
    android:padding="32dp">

    <!-- Ícone de relógio / pendente -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardCornerRadius="48dp"
        app:cardBackgroundColor="@color/primary_dark"
        app:cardElevation="0dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⏳"
            android:textSize="40sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastro enviado!"
        android:textSize="22sp"
        android:textColor="@color/primary_dark"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Mensagem -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seu cadastro está sendo analisado pela administração. Você receberá acesso assim que sua conta for aprovada."
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="12dp" />

    <!-- Informação extra -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Isso pode levar até 24 horas úteis."
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:textAlignment="center"
        android:layout_marginBottom="40dp" />

    <!-- Divisor -->
    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:background="@color/primary_dark"
        android:layout_marginBottom="40dp" />

    <!-- Card de status -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Status item -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="✓"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:background="@color/primary_dark"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cadastro enviado"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- Status item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="⏳"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aguardando aprovação do admin"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Status item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="○"
                    android:textSize="13sp"
                    android:textColor="@color/border_color"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acesso liberado ao QR Code"
                    android:textSize="14sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Botão sair -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSair"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Sair"
        android:textSize="14sp"
        android:textColor="@color/primary_dark"
        app:strokeColor="@color/primary_dark"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp" />

</LinearLayout>
